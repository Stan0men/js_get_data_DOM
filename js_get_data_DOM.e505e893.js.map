'use strict';
// write your code here
var populationEl = document.querySelectorAll('.population');
var totalPop = document.querySelector('.total-population');
var averagePop = document.querySelector('.average-population');
var totalPopulation = 0;
for(var i = 0; i < populationEl.length; i++){
    var text = populationEl[i].textContent;
    var cleanText = text.split(',').join('');
    var number = Number(cleanText);
    totalPopulation += number;
}
var averagePopulation = totalPopulation / populationEl.length;
totalPop.textContent = totalPopulation.toLocaleString('en-US');
averagePop.textContent = averagePopulation.toLocaleString('en-US', {
    maximumFractionDigits: 0
});

